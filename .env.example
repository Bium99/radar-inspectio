# Copia in .env e compila solo ciò che usi. .env non si versiona.

# Casella dedicata agli avvisi (Malt, Upwork, LinkedIn, Contra): IMAP con password per app
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Reddit: app di tipo "script" o "web" da https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Telegram: bot creato con @BotFather; CHAT_ID = la tua chat con il bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facoltativo, solo per `radar bozza <id> --llm`
ANTHROPIC_API_KEY=
